{
  "manifest_version": 1,
  "id": "yavqo.dark-pages",
  "name": "Dark Pages",
  "version": "1.0.0",
  "description": "Turns bright websites dark. Photos and video keep their real colours.",
  "author": "Yavqo",
  "icon": "icon.svg",
  "tags": ["appearance", "reading"],
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": { "title": "Dark Pages", "popup": "popup.html", "popup_width": 300, "popup_height": 190 }
}
