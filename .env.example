# Saturn Configuration
# Copy to .env and fill in

# LLM Provider — choose one
# OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# For Ollama (local): uncomment
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# Vercel AI Gateway — Zarah sidebar (xiaomi/mimo-v2.6-flash)
AI_GATEWAY_API_KEY=...

# Orcarouter — Voice Agent (z-ai/glm-5.3-flash-free)
ORCAROUTER_API_KEY=...

# For Anthropic via compatibility layer or OpenRouter
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=anthropic/claude-3.5-sonnet

# Browser
SATURN_HEADLESS=false
SATURN_MAX_STEPS=30
SATURN_TIMEOUT_MS=30000

# Server
SATURN_PORT=8765

# Supabase — scaffold only, no features yet
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
