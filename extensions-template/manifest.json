{
  "manifest_version": 1,
  "id": "local.my-extension",
  "name": "My Extension",
  "version": "1.0.0",
  "description": "Outlines the links on a page. Replace this with what your extension does.",
  "author": "Your Name",
  "icon": "icon.svg",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://example.com/*",
        "https://*.wikipedia.org/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "title": "My Extension",
    "popup": "popup.html",
    "popup_width": 320,
    "popup_height": 220
  },
  "long_description": "details.md",
  "homepage": "https://github.com/Yavqo/Saturn/blob/main/docs/extensions.md"
}
